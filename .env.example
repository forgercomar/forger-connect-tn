# === TiendaNube app (partners.tiendanube.com — app 32980) ===
TN_CLIENT_ID=
TN_CLIENT_SECRET=

# === Shared secret HMAC con los plugins WP — openssl rand -base64 48 ===
WFTN_OAUTH_HUB_SECRET=

# === Key AES-256 (32 bytes base64) para cifrar tokens at-rest — openssl rand -base64 32 ===
WFTN_TOKEN_KEY=

# === URL pública del central. El callback registrado en TN debe ser
#     {BASE_URL}/connect-tn/oauth/callback ===
BASE_URL=https://goforger.com

# === Postgres ===
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# === Opcionales (tienen defaults sensatos) ===
# TN_OAUTH_BASE=https://www.tiendanube.com   # Brasil (Nuvemshop): https://www.nuvemshop.com.br
# TN_API_BASE=https://api.tiendanube.com
# TN_API_VERSION=2025-03
# TN_USER_AGENT=Forger (info@forger.com.ar)
# PORT=3000
# DATA_DIR=/data
# WFTN_WORKER_INTERVAL=5000          # ms entre ticks del worker
# WFTN_RATE_MIN_INTERVAL_MS=500      # espaciado entre requests a TN (~2/s, leaky-bucket)
# WFTN_AUTOSYNC_INTERVAL_HOURS=6     # cada cuánto resincroniza una tienda
# WFTN_AUTOSYNC_FULL_HOURS=24        # cada cuánto el sync periódico es full
# WFTN_ZOMBIE_TIMEOUT_MIN=15         # timeout para reclamar jobs colgados
